    {
      "id": "bepinex",
      "name": "BepInEx",
      "engines": ["Unity Mono", "Unity IL2CPP", ".NET Framework", "XNA", "FNA", "MonoGame"],
      "automation": "guided",
      "prerequisites": [
        "Select a build matching runtime (Unity Mono vs IL2CPP) and architecture (x86/x64).",
        "Prefer a game-specific Thunderstore pack when the community maintains one.",
        "Run the game once after loader installation so config and log files are generated."
      ],
      "loader_targets": ["{game_root}/BepInEx", "{game_root}/winhttp.dll", "{game_root}/doorstop_config.ini"],
      "mod_targets": [
        {"kind": "plugin", "path": "{game_root}/BepInEx/plugins", "extensions": [".dll"], "recursive": true},
        {"kind": "preloader_patcher", "path": "{game_root}/BepInEx/patchers", "extensions": [".dll"], "recursive": true},
        {"kind": "config", "path": "{game_root}/BepInEx/config", "extensions": [".cfg"], "recursive": true}
      ],
      "detection": ["BepInEx/core", "BepInEx/plugins", "doorstop_config.ini", "winhttp.dll", "BepInEx/LogOutput.log"],
      "risks": ["BepInEx 5 and 6 plugin ABI is not interchangeable.", "IL2CPP builds and Mono builds are not interchangeable."],
      "sources": [
        "https://docs.bepinex.dev/master/articles/user_guide/installation/index.html",
        "https://docs.bepinex.dev/master/articles/dev_guide/plugin_tutorial/index.html",
        "https://docs.bepinex.dev/master/articles/user_guide/configuration.html"
      ]
    },
