      "id": "sims3_native",
      "name": "The Sims 3 package and Sims3Pack systems",
      "engines": ["The Sims 3 proprietary engine"],
      "automation": "guided",
      "prerequisites": [
        "Launch the game once so it creates the active user-data folder.",
        "Resolve the Windows-designated Documents directory; it may be redirected into OneDrive.",
        "For .package mods, create Mods/Packages and place Resource.cfg directly in Mods.",
        "Use Overrides only when a mod author explicitly requires it."
      ],
      "loader_targets": [
        "{windows_documents}/Electronic Arts/The Sims 3/Mods/Resource.cfg"
      ],
      "mod_targets": [
        {"kind": "package_mod", "path": "{windows_documents}/Electronic Arts/The Sims 3/Mods/Packages/{creator_or_package}", "extensions": [".package"], "recursive": true},
        {"kind": "override_package", "path": "{windows_documents}/Electronic Arts/The Sims 3/Mods/Overrides", "extensions": [".package"], "recursive": true},
        {"kind": "launcher_staging", "path": "{windows_documents}/Electronic Arts/The Sims 3/Downloads", "extensions": [".sims3pack"], "recursive": false},
        {"kind": "saved_sim", "path": "{windows_documents}/Electronic Arts/The Sims 3/SavedSims", "extensions": [".sim"], "recursive": false}
      ],
      "detection": [
        "{windows_documents}/Electronic Arts/The Sims 3/Options.ini",
        "{windows_documents}/Electronic Arts/The Sims 3/Mods/Resource.cfg",
        "{windows_documents}/Electronic Arts/The Sims 3/DCCache"
      ],
      "install_chain": [
        "Extract archives and classify .package, .sims3pack and .sim separately.",
        "Copy .package files below Mods/Packages; never put Resource.cfg inside Packages.",
        "Stage .sims3pack files in Downloads and hand installation to The Sims 3 Launcher.",
        "Treat a Sims3Pack as installed only after Launcher confirmation; Downloads is staging, not the loaded content store.",
        "Inventory Launcher-installed third-party content through DCCache .dbc files without editing those containers."
      ],
      "diagnostics": [
        "Validate the Mods/Resource.cfg + Mods/Packages structure.",
        "Distinguish package mods from Launcher-installed Sims3Packs.",
        "Detect duplicate packages and conflicting core/script mods.",
        "Track game version 1.67 vs 1.69 and expansion requirements.",
        "Offer removal of generated CASPartCache.package, compositorCache.package, scriptCache.package, simCompositorCache.package and socialCache.package after mod changes.",
        "Use small Launcher install batches and retain original Sims3Packs outside Downloads as recovery copies."
      ],
      "risks": [
        "The Launcher merges Sims3Pack content into DCCache containers, so file-copy rollback is not granular.",
        "Do not directly rewrite or delete individual records inside .dbc/.ebc files.",
        "Old Program Files-era package frameworks must not coexist with the Documents framework.",
        "A file present in Downloads is not necessarily installed."
      ],
      "sources": [
        "https://forums.ea.com/discussions/the-sims-3-technical-issues-en/how-do-i-make-mods-folder-in-the-sims-3/13137989/replies/13320305",
        "https://modthesims.info/wiki.php?title=Sims_3:Installing_Package_Files",
        "https://modthesims.info/wiki.php?title=Game_Help:Installing_TS3_Packs",
        "https://modthesims.info/wiki.php?title=Game_Help:TS3_User_Folders_Explained"
      ]
    },
