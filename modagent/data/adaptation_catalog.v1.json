      "id": "sims4_native",
      "name": "The Sims 4 user-content system",
      "engines": ["The Sims 4 proprietary engine"],
      "automation": "guided",
      "prerequisites": [
        "Launch the game once so it creates the active user-data folder and Resource.cfg.",
        "Resolve the Windows-designated Documents directory; it may be redirected into OneDrive.",
        "Enable Custom Content and Mods in Game Options > Other.",
        "Enable Script Mods separately when the package contains .ts4script files, then restart the game."
      ],
      "loader_targets": [
        "{windows_documents}/Electronic Arts/The Sims 4/Mods/Resource.cfg"
      ],
      "mod_targets": [
        {"kind": "custom_content", "path": "{windows_documents}/Electronic Arts/The Sims 4/Mods/{creator_or_package}", "extensions": [".package"], "recursive": true, "max_depth": 5},
        {"kind": "script_mod", "path": "{windows_documents}/Electronic Arts/The Sims 4/Mods/{mod}", "extensions": [".ts4script", ".package"], "recursive": false, "max_depth": 1},
        {"kind": "tray_content", "path": "{windows_documents}/Electronic Arts/The Sims 4/Tray", "extensions": [".blueprint", ".bpi", ".hhi", ".householdbinary", ".room", ".sgi", ".trayitem"], "recursive": false}
      ],
      "detection": [
        "{windows_documents}/Electronic Arts/The Sims 4/Options.ini",
        "{windows_documents}/Electronic Arts/The Sims 4/GameVersion.txt",
        "{windows_documents}/Electronic Arts/The Sims 4/Mods/Resource.cfg"
      ],
      "install_chain": [
        "Classify archive contents before extraction.",
        "Reject executables and archives nested as install payload unless the creator explicitly documents them.",
        "Preserve one creator/mod folder directly below Mods for script mods.",
        "Keep Tray assets out of Mods and install the complete same-basename asset set together.",
        "After installation, confirm files are listed by the game's startup mod list."
      ],
      "diagnostics": [
        "Detect multiple active-looking The Sims 4 folders and identify the one containing the currently loaded save path.",
        "Detect OneDrive cloud-only files, sync conflicts and deleted mods that reappear.",
        "Detect script mods deeper than one subfolder and package files deeper than Resource.cfg allows.",
        "Detect duplicate files by hash and likely duplicate package resources.",
        "Record game patch version and creator compatibility version.",
        "After removing or changing mods, offer to remove the generated localthumbcache.package.",
        "Provide a reversible 50/50 isolation workflow without moving saves."
      ],
      "risks": [
        "Game updates disable mods and can make script mods incompatible.",
        "Do not install user content into the EA App/Steam game program directory.",
        "OneDrive can rename, restore, lock or cloud-evict user files.",
        "Never load and save an important household while required CC or gameplay mods are missing."
      ],
      "sources": [
        "https://help.ea.com/en/articles/the-sims/the-sims-4/how-to-install-mods-the-sims-4/",
        "https://help.ea.com/en/articles/the-sims/the-sims-4/mods-and-the-sims-4-game-updates/",
        "https://forums.ea.com/discussions/the-sims-4-mods-and-custom-content-en/re-info-how-to-use-mods-and-cc/9360655",
        "https://forums.ea.com/kb/the-sims-helpers-blog-en/guide-pc-managing-onedrive/12636625/"
      ]
    },
